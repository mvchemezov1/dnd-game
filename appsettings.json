      },
      "spell": {
        "Name": "spell",
        "MaxRequests": 3,
        "Window": "00:00:15",
        "Algorithm": "TokenBucket"
      },
      "movement": {
        "Name": "movement",
        "MaxRequests": 10,
        "Window": "00:00:10",
        "Algorithm": "TokenBucket"
      },
      "rest": {
        "Name": "rest",
        "MaxRequests": 2,
        "Window": "00:01:00",
        "Algorithm": "TokenBucket"
      },
      "global": {
        "Name": "global",
        "MaxRequests": 30,
        "Window": "00:00:10",
        "Algorithm": "TokenBucket"
      },
      "websocket-connect": {
        "Name": "websocket-connect",
        "MaxRequests": 10,
        "Window": "00:01:00",
        "Algorithm": "SlidingWindow"
      },
      "websocket-message": {
        "Name": "websocket-message",
        "MaxRequests": 60,
        "Window": "00:00:10",
        "Algorithm": "TokenBucket"
      }
    }
  },
    "Smtp": {
      "Host": "smtp.yourserver.com",
      "Port": 587,
      "EnableSsl": true,
      "Username": "your_username",
      "Password": "your_password",
      "FromEmail": "noreply@yourdomain.com",
      "FromName": "DnD Game"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "https://my-game-frontend.com"
    ]
  },
  "Jwt": {
    "AccessTokenExpirationMinutes": 60,
    "Audience": "DnD.Players",
    "Issuer": "DnD.Game",
    "RefreshTokenExpirationDays": 7,
    "Secret": ""
  },
  "Token": {
    "Secret": "",
    "Issuer": "DnD.Game",
    "Audience": "DnD.Players",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7,
    "ValidateIssuerSigningKey": true,
    "ValidateLifetime": true
  },
  "RefreshTokenCleanup": {
    "IntervalMinutes": 60
  },
  "Migration": {
    "AutoMigrate": true,
    "ScriptsPath": "Migrations"
  },
  "Cache": {
    "CharacterTtlMinutes": 5,
    "CombatTtlMinutes": 1,
    "CampaignTtlMinutes": 10
  }

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<IsPackable>false</IsPackable>
		<AssemblyName>dnd_game.Tests</AssemblyName>
		<RootNamespace>dnd_game.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<!-- Правильный относительный путь -->
		<ProjectReference Include="..\dnd_game.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- tests/loadtest — отдельный консольный проект (dnd_game.LoadTest.csproj) со своим
		     Main. Без этого исключения SDK-style проект по умолчанию компилирует **/*.cs
		     рекурсивно и подхватывает loadtest/Program.cs прямо в dnd_game.Tests — из-за
		     этого возникает CS8892 (конфликт между его Main и авто-сгенерированной точкой
		     входа тестового хоста) и дублирование сборки. -->
		<Compile Remove="loadtest\**\*.cs" />
	</ItemGroup>
</Project>